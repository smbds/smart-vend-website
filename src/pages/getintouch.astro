---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// Replace with your actual Google Business Profile "write a review" link.
// Format: https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
const GOOGLE_REVIEW_URL = "https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID";

const cards = [
  {
    title: "Support Request",
    description:
      "Need help with a recent transaction or want to report an issue with the machine? Submitting the form is the fastest way to reach the right team.",
    href: "/support",
    cta: "Open a request",
    external: false,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>`,
  },
  {
    title: "Get a Machine",
    description:
      "Want a free smart vending machine for your business or office? Tell us about your space and we'll handle the rest.",
    href: "/request-machine",
    cta: "Request a machine",
    external: false,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>`,
  },
  {
    title: "Request Drinks & Snacks",
    description:
      "Craving something specific? Suggest the drinks, snacks, or fresh food you'd like to see stocked in your machine.",
    href: "/request-items",
    cta: "Suggest items",
    external: false,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>`,
  },
  {
    title: "Write a Review",
    description:
      "Love your SmartMart? Share your experience on Google — it helps other local businesses discover us.",
    href: GOOGLE_REVIEW_URL,
    cta: "Leave a review",
    external: true,
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>`,
  },
];
---

<Layout
  title="Get in Touch | Smart Vend NC"
  description="Reach Smart Vend NC for machine support, to request a free vending machine, suggest products, or leave a review. We're here to help businesses across the Triangle."
>
  <Navbar />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-off-white via-white to-primary-light py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary-light text-primary rounded-full text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 4v-4z"/></svg>
        Get in Touch
      </div>
      <h1 class="font-heading text-4xl sm:text-5xl font-bold text-gray mb-4">
        How can we help?
      </h1>
      <p class="text-lg text-gray-light max-w-2xl mx-auto">
        Pick the option that fits — whether you need support, want a machine, have product requests, or just want to share some love. We respond within 24 hours.
      </p>
    </div>
  </section>

  <!-- 2x2 Cards -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 gap-6">
        {cards.map((card) => (
          <a
            href={card.href}
            target={card.external ? "_blank" : undefined}
            rel={card.external ? "noopener noreferrer" : undefined}
            class="group relative flex flex-col h-full bg-white rounded-2xl p-8 border border-gray-muted/15 shadow-[0_2px_16px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_40px_rgba(45,164,73,0.12)] hover:border-primary/30 hover:-translate-y-1 transition-all duration-300"
          >
            <div class="flex items-center justify-center w-14 h-14 rounded-xl bg-primary-light text-primary mb-6 group-hover:bg-primary group-hover:text-white transition-colors duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={card.icon} />
            </div>
            <h2 class="font-heading text-xl font-bold text-gray mb-2">{card.title}</h2>
            <p class="text-gray-light leading-relaxed flex-1">{card.description}</p>
            <span class="inline-flex items-center gap-1.5 mt-6 text-primary font-semibold text-sm">
              {card.cta}
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
            {card.external && (
              <svg class="absolute top-6 right-6 w-4 h-4 text-gray-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            )}
          </a>
        ))}
      </div>

      <!-- Fallback contact -->
      <p class="text-center text-gray-light mt-12">
        Prefer to talk to a person? Call us at
        <a href="tel:9193558122" class="text-primary font-semibold hover:underline">(919) 355-8122</a>
        or email
        <a href="mailto:info@smartvendnc.com" class="text-primary font-semibold hover:underline">info@smartvendnc.com</a>.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
