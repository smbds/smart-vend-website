---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string; // SEO page title
  metaDescription: string;
  badge: string;
  heading: string;
  subheading: string;
  formSlug: string; // Scalio data-form-slug value
  points?: string[]; // optional reassurance bullets shown beside the form
  icon: string; // raw SVG path markup for the badge icon
  notice?: string; // optional highlighted message shown above the form
}

const {
  title,
  metaDescription,
  badge,
  heading,
  subheading,
  formSlug,
  points = [],
  icon,
  notice,
} = Astro.props;
---

<Layout title={title} description={metaDescription}>
  <Navbar />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-off-white via-white to-primary-light py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-primary-light text-primary rounded-full text-sm font-medium mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={icon} />
        {badge}
      </div>
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-gray mb-4">{heading}</h1>
      <p class="text-lg text-gray-light max-w-2xl mx-auto">{subheading}</p>
    </div>
  </section>

  <!-- Form -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class={points.length ? "grid lg:grid-cols-[1fr_320px] gap-10 items-start" : "max-w-2xl mx-auto"}>
        <!-- Form widget -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-gray-muted/15 shadow-[0_2px_16px_rgba(0,0,0,0.05)]">
          {notice && (
            <div class="flex items-start gap-3 mb-6 px-4 py-3.5 rounded-xl bg-primary-light border border-primary/15">
              <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              <p class="text-sm text-gray leading-relaxed">{notice}</p>
            </div>
          )}
          <div data-form-slug={formSlug}></div>
          <noscript>
            <p class="text-gray-light text-center py-8">
              This form requires JavaScript. Please email
              <a href="mailto:info@smartvendnc.com" class="text-primary font-semibold">info@smartvendnc.com</a>
              or call <a href="tel:9193558122" class="text-primary font-semibold">(919) 355-8122</a>.
            </p>
          </noscript>
        </div>

        <!-- Side panel -->
        {points.length > 0 && (
          <aside class="space-y-6">
            <div class="bg-off-white rounded-2xl p-6 border border-gray-muted/10">
              <h2 class="font-heading text-lg font-bold text-gray mb-4">What to expect</h2>
              <ul class="space-y-3">
                {points.map((point) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    <span class="text-gray-light text-sm leading-relaxed">{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="bg-primary rounded-2xl p-6 text-white">
              <h3 class="font-heading text-lg font-bold mb-1">Need it now?</h3>
              <p class="text-white/80 text-sm mb-4">Reach us directly during business hours.</p>
              <a href="tel:9193558122" class="flex items-center gap-2.5 font-bold text-lg hover:underline">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                (919) 355-8122
              </a>
              <a href="mailto:info@smartvendnc.com" class="flex items-center gap-2.5 font-semibold text-sm mt-3 text-white/90 hover:text-white hover:underline break-all">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                info@smartvendnc.com
              </a>
            </div>

            <a href="/getintouch" class="inline-flex items-center gap-1.5 text-sm text-gray-light hover:text-primary transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              Back to all options
            </a>
          </aside>
        )}
      </div>
    </div>
  </section>

  <Footer />

  <!-- Scalio forms widget -->
  <script src="https://app.getscalio.com/forms-widget.js" async is:inline></script>
</Layout>
